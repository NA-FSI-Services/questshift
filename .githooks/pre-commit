#!/usr/bin/env bash
# ruff + spec checker coverage for the docs repo.
set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

CONFIG="$ROOT/.githooks/config"
if [[ -f "$CONFIG" ]]; then
    # shellcheck disable=SC1090
    source "$CONFIG"
fi

if [[ "${SKIP_QUESTSHIFT_HOOKS:-}" == "1" ]]; then
    echo "questshift pre-commit: skipped (SKIP_QUESTSHIFT_HOOKS=1)"
    exit 0
fi

if ! git diff --cached --name-only --diff-filter=ACMR | grep -Eq '\.(md|py|toml)$|^docs/|^\.githooks/|^verify\.sh$|^AGENTS\.md$|^CONTRIBUTING\.md$'; then
    exit 0
fi

echo "questshift pre-commit: ruff, spec checks, coverage"
./verify.sh
